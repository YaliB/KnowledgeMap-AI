#OpenAI
OPENAI_API_KEY=key

#Neo4j
NEO4J_URI=uri
NEO4J_USERNAME=username
NEO4J_PASSWORD=password
NEO4J_DBNAME=dbname

#MongoDB
MONGODB_URI=uri
MONGODB_DB=db

#Session
SESSION_SECRET=secret
SESSION_EXPIRE_DAYS=number

#File Storage
MAX_FILE_SIZE_MB=20

#S3 (set USE_S3=false for local dev — no AWS needed)
USE_S3=false
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=us-east-1
S3_BUCKET=knowledgemap-uploads

#App
ALLOWED_ORIGINS=["http://localhost:3000"]
